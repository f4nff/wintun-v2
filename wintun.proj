<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <!-- One authoritative build graph. Signed input packages are immutable. -->
  <Target Name="Tests"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage Tests" /></Target>
  <Target Name="UnifiedTests"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage UnifiedTests" /></Target>
  <Target Name="Safety"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage Safety" /></Target>
  <Target Name="Driver"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage Driver" /></Target>
  <Target Name="Dll"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage Api" /></Target>
  <Target Name="Probe"><Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="pwsh -NoProfile -File tools\build\build.ps1 -Stage Probe" /></Target>
  <Target Name="Build" DependsOnTargets="Tests;Safety;Driver;Dll" />
  <Target Name="Driver-amd64" DependsOnTargets="Driver" />
  <Target Name="Dll-amd64" DependsOnTargets="Dll" />
  <Target Name="Clean"><Message Importance="high" Text="Fingerprint builds and signing inputs are preserved under out/. Remove an explicitly selected unsigned build directory separately." /></Target>
</Project>

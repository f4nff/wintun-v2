; SPDX-License-Identifier: GPL-2.0
; Independent development identity; does not replace the official Wintun service.
[Version]
Signature = "$Windows NT$"
Class = Net
ClassGUID = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider = %Provider%
CatalogFile = packetbridge.cat
PnpLockdown = 1

[Manufacturer]
%Provider% = PacketBridgeV2, NTamd64.10.0...26100

[PacketBridgeV2.NTamd64.10.0...26100]
%Description% = Install, PacketBridgeV2

[SourceDisksNames]
1 = %Description%, "", ,

[SourceDisksFiles]
packetbridge.sys = 1

[DestinationDirs]
CopyDriver = 13

[CopyDriver]
packetbridge.sys

[Install]
Characteristics = 0x1
AddReg = Ndi
CopyFiles = CopyDriver
*IfType = 6
*MediaType = 0
*PhysicalMediaType = 0
EnableDhcp = 0

[Install.Services]
AddService = packetbridge, 2, Service

[Ndi]
HKR, Ndi, Service, 0, packetbridge
HKR, Ndi\Interfaces, UpperRange, , "ndis5"
HKR, Ndi\Interfaces, LowerRange, , "nolower"

[Service]
DisplayName = %Description%
Description = %Description%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\packetbridge.sys

[Strings]
Provider = "PacketBridgeV2 Project"
Description = "PacketBridgeV2 IP Adapter"

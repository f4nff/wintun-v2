#include <windows.h>
#include "packetbridge_version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION PB_VERSION_MAJOR, PB_VERSION_MINOR, PB_VERSION_PATCH, PB_VERSION_BUILD
PRODUCTVERSION PB_VERSION_MAJOR, PB_VERSION_MINOR, PB_VERSION_PATCH, PB_VERSION_BUILD
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DRV
FILESUBTYPE VFT2_DRV_NETWORK
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PacketBridgeV2 Project"
      VALUE "FileDescription", "PacketBridgeV2 offload capability prototype"
      VALUE "FileVersion", PB_VERSION_STRING
      VALUE "ProductVersion", PB_VERSION_STRING
      VALUE "ProductName", "PacketBridgeV2"
      VALUE "InternalName", "packetbridge.sys"
      VALUE "OriginalFilename", "packetbridge.sys"
      VALUE "PrivateBuild", PB_SOURCE_STRING
      VALUE "LegalCopyright", "Based on Wintun. Copyright 2018-2026 WireGuard LLC. GPL-2.0."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
